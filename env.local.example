# Environment variable configuration example file
# Copy this file to .env.local and fill in your actual configuration

# ===== LLM API key configuration =====
# Configure the API keys of the LLM services you want to use
# Different modules use these configs as needed

# OpenAI API configuration
# VITE_OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini API configuration
# VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic Claude API configuration
# VITE_ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ===== Image generation API key configuration =====
# Gemini image generation reuses VITE_GEMINI_API_KEY (no separate configuration needed)
# Seedream (Doubao) / Volcano Ark ARK API Key (either variable works, with priority from top to bottom)
# VITE_SEEDREAM_API_KEY=your-seedream-api-key-here
# VITE_ARK_API_KEY=your-ark-api-key-here
# (The process environment variable ARK_API_KEY is also supported, but using the VITE_ prefix throughout is recommended)

# DeepSeek API configuration
# VITE_DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Zhipu AI API configuration
# VITE_ZHIPU_API_KEY=your-zhipu-api-key-here

# SiliconFlow API configuration
# VITE_SILICONFLOW_API_KEY=sk-your-siliconflow-api-key-here

# ModelScope API configuration - 2000 free calls per day
# Supports text models (LLM) and image generation models
# VITE_MODELSCOPE_API_KEY=your-modelscope-sdk-token-here

# Custom API configuration (such as a local Ollama service)
# VITE_CUSTOM_API_KEY=your-custom-api-key
# VITE_CUSTOM_API_BASE_URL=http://localhost:11434/v1
# VITE_CUSTOM_API_MODEL=qwen2.5:0.5b

# ===== Multi custom model configuration (new feature) =====
# Supports configuring an unlimited number of custom models, using a suffix to tell them apart
# Format: VITE_CUSTOM_API_*_<suffix>
# Suffix rules: may only contain letters (a-z A-Z), digits (0-9), underscores (_), and hyphens (-)
# Not supported: dots (.), spaces, special symbols, etc.

# Ollama Qwen model example
# VITE_CUSTOM_API_KEY_qwen3=ollama-qwen3-key
# VITE_CUSTOM_API_BASE_URL_qwen3=http://localhost:11434/v1
# VITE_CUSTOM_API_MODEL_qwen3=qwen3:8b

# Ollama Qwen2.5 model example (note: separate the version number with an underscore)
# VITE_CUSTOM_API_KEY_qwen2_5=ollama-qwen25-key
# VITE_CUSTOM_API_BASE_URL_qwen2_5=http://localhost:11434/v1
# VITE_CUSTOM_API_MODEL_qwen2_5=qwen2.5:14b

# Local Claude-compatible service example
# VITE_CUSTOM_API_KEY_claude_local=claude-local-key
# VITE_CUSTOM_API_BASE_URL_claude_local=http://localhost:8080/v1
# VITE_CUSTOM_API_MODEL_claude_local=claude-3-sonnet

# Other self-hosted API service example
# VITE_CUSTOM_API_KEY_my_llm=my-llm-api-key
# VITE_CUSTOM_API_BASE_URL_my_llm=https://my-api.example.com/v1
# VITE_CUSTOM_API_MODEL_my_llm=my-custom-model

# Notes:
# - The following three are all required: API_KEY, BASE_URL, MODEL (strictly consistent with the core implementation)
# - The generated model is shown in the UI with a formatted name (e.g. qwen3 → Qwen3)

# ===== MCP server configuration =====
# The following config is only needed when using the MCP server

# Preferred model provider (when multiple API keys are configured)
# Options: openai, gemini, anthropic, deepseek, siliconflow, zhipu, dashscope, openrouter, modelscope, custom, custom_<suffix>
# Note: it must correspond to the API keys configured above
# Example: if VITE_CUSTOM_API_KEY_qwen3 is configured, you can use custom_qwen3
# MCP_DEFAULT_MODEL_PROVIDER=openai

# HTTP server port (default 3000)
# MCP_HTTP_PORT=3000

# Log level (default debug)
# Options: debug, info, warn, error
# MCP_LOG_LEVEL=debug

# Default language (default en; only English is supported)
# Options: en
# MCP_DEFAULT_LANGUAGE=en

# ===== Docker deployment access control configuration =====
# The following config is only needed for Docker deployments, to set access control for the web interface

# Access username (optional, defaults to admin)
# ACCESS_USERNAME=admin

# Access password (optional; without it there is no password protection)
# ACCESS_PASSWORD=your_password

# ===== Development update test configuration =====
# Uncomment the following config to enable the update test feature in the development environment

# Option 1: use the GITHUB_REPOSITORY environment variable (recommended)
# GITHUB_REPOSITORY=your-username/your-repo-name

# Option 2: set the repository owner and name separately
# DEV_REPO_OWNER=your-username
# DEV_REPO_NAME=your-repo-name

# ===== Usage notes =====
#
# LLM API keys:
# 1. Use environment variables with the VITE_ prefix; supported by all modules (Web, Desktop, MCP server, etc.)
# 2. Configure the corresponding API keys depending on the features you use
# 3. The custom API supports local services (such as Ollama) and other services compatible with the OpenAI format
# 4. Multi custom models: configure multiple custom models using the VITE_CUSTOM_API_*_<suffix> format
#    - Supports an unlimited number of custom models
#    - Each model is shown as a separate option in the UI
#    - The suffix name is automatically formatted into a friendly display name
#
# MCP server (only needed when using the MCP feature):
# 1. At least one API key must be configured to start
# 2. Run pnpm mcp:dev in the project root to start the dev server
# 3. If multiple API keys are configured, MCP_DEFAULT_MODEL_PROVIDER can specify the preferred one
# 4. Supported values of MCP_DEFAULT_MODEL_PROVIDER:
#    - openai: use OpenAI GPT models
#    - gemini: use Google Gemini models
#    - deepseek: use DeepSeek models
#    - siliconflow: use SiliconFlow models
#    - zhipu: use Zhipu AI models
#    - custom: use a custom API (such as Ollama)
#    - custom_<suffix>: use a specific multi custom model (such as custom_qwen3)
# 5. The HTTP mode default port is 3000 and can be changed via MCP_HTTP_PORT
# 6. debug logging is enabled by default and can be adjusted via MCP_LOG_LEVEL
#
# Docker deployment access control:
# 1. ACCESS_USERNAME and ACCESS_PASSWORD are only used for Docker deployments
# 2. Without a password there is no access restriction
# 3. After a password is set, accessing the web interface requires entering the username and password
#
# Update tests (only needed in the development environment):
# 1. Only public repositories are supported, not private ones
# 2. If no repository config is set, the default public repository (linshenkx/prompt-optimizer) is used
# 3. The development environment now supports update tests by default, without an extra config file
# 4. Update logs are saved in the logs/auto-updater.log file in the user data directory
