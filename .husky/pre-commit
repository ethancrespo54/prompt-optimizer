#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Check whether a package-lock.json or yarn.lock file exists
if [ -f "package-lock.json" ]; then
  echo "Error: package-lock.json detected."
  echo "This project enforces pnpm as the package manager. Please delete package-lock.json and install dependencies with pnpm install."
  exit 1
fi

if [ -f "yarn.lock" ]; then
  echo "Error: yarn.lock detected."
  echo "This project enforces pnpm as the package manager. Please delete yarn.lock and install dependencies with pnpm install."
  exit 1
fi

# Make sure pnpm-lock.yaml exists
if [ ! -f "pnpm-lock.yaml" ]; then
  echo "Warning: pnpm-lock.yaml not detected."
  echo "Please make sure to install dependencies with pnpm install."
fi 

# Test gate (can be skipped with SKIP_TEST_GATE=1, for emergencies only)
if [ "$SKIP_TEST_GATE" = "1" ]; then
  echo "Skipping the test gate: SKIP_TEST_GATE=1 detected"
  exit 0
fi

echo "Running the test gate (fast): pnpm test:gate"
pnpm test:gate
